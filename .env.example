# 이 파일을 .env 로 복사한 뒤 실제 값을 채운다
# .env 는 .gitignore 에 등록돼 있으므로 커밋되지 않는다

# Supabase — 대시보드 > Project Settings > API
SUPABASE_DSN=postgresql://postgres.[project-ref]:[password]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...   # anon (public) 키

# 카카오 REST API 키 (서버 사이드 배치 지오코딩용)
# developers.kakao.com > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_REST_KEY=your_kakao_rest_key_here

# 네이버 지도 Client ID (브라우저에 노출됨 — 콘솔에서 도메인 제한 필수)
# ncloud.com > AI·NAVER API > Maps > Web Dynamic Map
NEXT_PUBLIC_NAVER_CLIENT_ID=your_naver_client_id_here
